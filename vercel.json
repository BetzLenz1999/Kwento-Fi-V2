{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "installCommand": "pip install --no-cache-dir -r requirements.txt",
  "functions": {
    "main.py": {
      "includeFiles": "{static/**,templates/**,community_garden_gas_sponsor.py}",
      "excludeFiles": "{tests/**,docs/**,scripts/**,contracts/**,node_modules/**,.git/**}",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/community/api/cron/daily-learn-reconcile",
      "schedule": "0 6 * * *"
    }
  ]
}
