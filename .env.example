# Core chain config
# Optional numeric settings may be omitted or left blank; invalid numeric values
# fall back to safe code defaults. Only credentials required by a feature need
# to be configured for that feature to run.
# Process-local recurring jobs are disabled by default on Vercel/Lambda because
# serverless instances can scale independently. Use one external scheduler for
# jobs that must continue running there; opt back in only intentionally.
# VERCEL_BACKGROUND_JOBS_ENABLED=1
# Canonical domain — all alias hosts (*.vercel.app, goodmarket.live) 308-redirect
# here. See canonical_host.py. Override to move the domain without a code change.
# CANONICAL_HOST=goodmarketph.live
# Base URLs used for links built off-request (schedulers, bots, share links)
# PRODUCTION_DOMAIN=https://goodmarketph.live
# BASE_URL=https://goodmarketph.live
# Private-message Web Push (server-side VAPID credentials; never expose the private key).
# Generate one stable key pair and keep it unchanged across deployments.
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@goodmarketph.live
# Primary Celo RPC endpoint
CELO_RPC_URL=https://forno.celo.org
# Note: The app includes fallback RPCs (1rpc.io/celo, celo.publicnode.com)
# for reliability when the primary endpoint is rate-limited or unavailable.

# Session lifetime (hours). The Flask session cookie expires after this much
# inactivity; any request inside the window refreshes it, so an active user
# stays logged in indefinitely. Default 48 covers users who lose power/connectivity
# for over a day. Raise it without a code change if needed.
# SESSION_LIFETIME_HOURS=48

# Minigames / Play & Earn disbursement (server-side). Rewards are sent
# through the GamesRewards smart contract (GAMES_REWARDS_CONTRACT)
# via disburseReward
# this wallet needs CELO gas. The G$ reward pool lives in the contract.
# Signer is SERVER_PRIVATE_KEY (authorized disburser).
SERVER_PRIVATE_KEY=0xyour_server_private_key
GAMES_REWARDS_CONTRACT=0xyour_games_rewards_contract

# UBI gas fallback (server-side) — GAMES_KEY calls topWallet(user) on the
# GoodDollar faucet contract.
GAMES_KEY=0xyour_games_private_key
GOODDOLLAR_FAUCET_CONTRACT=0x4F93Fa058b03953C851eFaA2e4FC5C34afDFAb84
GOODDOLLAR_FAUCET_API_URL=https://goodserver.gooddollar.org/verify/topWallet

# Optional faucet tuning
# FAUCET_MIN_CELO is the minimum-floor threshold for the gas readiness check.
# Wallets with balance below max(dynamic_required, FAUCET_MIN_CELO) trigger a
# faucet top-up. Default 0.1 CELO covers typical end-to-end claim cost during
# congestion (the previous 0.002–0.005 floors were too low and let WC / Trust
# users false-pass with only 0.06 CELO).
FAUCET_MIN_CELO=0.1
FAUCET_BUFFER_MULTIPLIER=1.35
FAUCET_DUPLICATE_WINDOW_MIN=30

# Chicken Farm (GoodMarket Chicken Farming)
# Deployed GoodMarketChickenFarm contract. While unset, the /farming page loads
# but every action is disabled with a "not configured" message. Reads (farm
# state, receipts) go through the public Celo RPC below, never the user's wallet.
# FARMING_CONTRACT_ADDRESS=0xyour_chicken_farm_contract
# CELO_RPC_URL=https://forno.celo.org
# CELO_RPC_FALLBACKS=https://forno.celo.org,https://rpc.ankr.com/celo,https://celo.drpc.org
# Block the farm contract was deployed at. Used as the anchor for the
# per-wallet on-chain history scan (/farming/api/history). Optional: when
# unset, it is discovered once via an eth_getCode binary search. Set it to skip
# that discovery (cheaper) or if the RPC has no archive state.
# FARMING_DEPLOY_BLOCK=

# MiniPay cUSD gas faucet (anti-farming controls)
# The faucet is gated on GoodDollar face verification (on-chain isWhitelisted),
# a per-wallet 48h cooldown, AND a global per-UTC-day disbursement cap. The cap
# bounds the worst-case pool drain across ALL wallets in one day; set it to 0 to
# disable. Sized as (expected daily unique claimers) * MINIPAY_CUSD_FAUCET_AMOUNT
# with headroom — tune to your pool size.
# MINIPAY_CUSD_FAUCET_AMOUNT=0.05
# MINIPAY_CUSD_FAUCET_DAILY_CAP=25
# MINIPAY_CUSD_FAUCET_COOLDOWN_SECONDS=172800

# Squid Router Buy Crypto widget (all OPTIONAL — every value defaults in code)
# The widget works out of the box with NO env vars: it ships with Squid's
# public "squid-swap-widget" integrator id, which authenticates against the
# Squid API without registration or contacting Squid support. Set
# SQUID_INTEGRATOR_ID only if you later register your own integrator id.
# SQUID_INTEGRATOR_ID=squid-swap-widget
# SQUID_API_URL=https://v2.api.squidrouter.com
# SQUID_FROM_CHAIN_ID=42220
# SQUID_TO_CHAIN_ID=8453
# Destination token defaults to native ETH on Base (Squid native placeholder):
# SQUID_TO_TOKEN=0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE
# Optional Celo source-token address overrides (CELO/cUSD/USDC/USDT):
# SQUID_CELO_TOKEN=0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE
# SQUID_CUSD_TOKEN=0x765DE816845861e75A25fCA122bb6898B8B1282a
# SQUID_USDC_TOKEN=0xcebA9300f2b948710d2653dD7B07f33A8B32118C
# SQUID_USDT_TOKEN=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e


# Supabase database (set these to the NEW project after migration)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-side only. Never expose this key to frontend clients.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Second Supabase project (optional feature split) ───────────────────
# Host a self-contained feature in its own Supabase project so its rows do not
# count against the primary project's free-tier DB size. Currently used for
# local (in-app, email + PIN) wallet accounts — `local_wallet_accounts` is
# read/written on this project when it is configured.
#
# The table has no foreign keys into other tables, so it migrates cleanly:
# run sql/local_wallet_accounts.sql (+ local_wallet_signup_completion.sql and
# local_wallet_verification.sql) in the second project, copy the rows, then set
# these. Leave them unset and everything falls back to the primary project.
# SUPABASE_URL2=https://your-second-project.supabase.co
# SUPABASE_ANON_KEY2=your-second-project-anon-key
# Server-side only. Never expose this key to frontend clients.
# SUPABASE_SERVICE_ROLE_KEY2=your-second-project-service-role-key

# ── Referral program ───────────────────────────────────────────────────
# Server wallet that pays referral rewards (needs G$ balance AND CELO gas).
REFERRAL_KEY=0xyour_referral_rewards_private_key
# Background reconciler: re-checks pending_face_verification referrals every
# interval and auto-disburses ones whose referee is now face-verified; also
# retries queued pending_disbursed legs (e.g. after topping up G$/CELO gas).
# Requires SUPABASE_SERVICE_ROLE_KEY for full coverage. On by default.
# REFERRAL_RECONCILER_ENABLED=1
# REFERRAL_RECONCILER_INTERVAL_SEC=900
# REFERRAL_RECONCILER_STUCK_HOURS=1
# Local (in-app, email + PIN) wallet face-verification reconciler. Backfills
# and refreshes the cached is_human_verified/verification_status columns on
# local_wallet_accounts from the on-chain Identity contract so admins can
# count/trace verified local-wallet users. On by default; set
# LOCAL_WALLET_VERIFICATION_ENABLED=0 to disable.
# LOCAL_WALLET_VERIFICATION_ENABLED=1
# LOCAL_WALLET_VERIFICATION_INTERVAL_SEC=3600
# LOCAL_WALLET_VERIFICATION_BATCH=200
# Abandoned local-wallet signups (registered but never logged in) are excluded
# from the admin verified/unverified counts. They are cleaned up on demand from
# Admin → Local Wallet Verification → "Clean up abandoned" (dry-run by default).
# Requires sql/local_wallet_signup_completion.sql to have been run for the
# signup_completed column to exist.
# A reward leg that previously FAILED (e.g. a transient "nonce too low"
# collision) is auto-retried by the reconciler once it is at least this old.
# 0 disables auto-retry of failed legs (they stay admin-retry-only).
# REFERRAL_RETRY_FAILED_AFTER_SEC=900
# A 'disbursing' row is an intermediate CAS-claim marker. If the worker dies
# mid-flight (gunicorn recycle) or the terminal DB write fails, the row would
# otherwise stay stuck forever and the dashboard showed a permanent
# "Disbursing (stuck? retry)". The reconciler resets a 'disbursing' row older
# than this back to pending_face_verification so it is retried automatically.
# Disbursement is duplicate-protected, so a reclaim can never double-pay.
# Requires sql/referral_disbursing_at.sql (the reclaim is skipped without it).
# REFERRAL_STALE_CLAIM_SEC=300
# How far back to accept a CONFIRMED Celo UBI claim as proof that the referee
# is face-verified. UBIScheme.claim() reverts for a non-whitelisted caller, so
# a successful claim is definitive proof — it rescues payouts when the
# isWhitelisted read is stale/lagging. Default 30 days.
# REFERRAL_UBI_CLAIM_EVIDENCE_DAYS=30

# Face-verification (Identity.isWhitelisted) read cache. A VERIFIED answer is
# cached for IDENTITY_CACHE_TTL (30 min). A "not verified" answer is the one
# that gates payouts and is usually read the instant the FV callback lands —
# often before GoodDollar's addWhitelisted tx is mined — so it is cached for
# only IDENTITY_NEGATIVE_CACHE_TTL seconds (default 60) and then re-checked.
# IDENTITY_NEGATIVE_CACHE_TTL=60

# ── Telegram bot /tip (admin-only manual tips) ──────────────────────────
# Admin-only /tip command: real G$ / CELO / USDT / USDC / cUSD (Celo) or
# XDC / XDC G$ sent to a registered member's saved wallet, signed by this DEDICATED hot
# wallet. Keep the balance LOW and top up on demand — a Telegram admin cannot
# exceed the caps below, but anyone with server access can read this key.
# Run sql/telegram_tips.sql in Supabase before enabling.
TIP_KEY=0xyour_tip_private_key
# Optional: restrict /tip to specific Telegram user IDs (comma-separated).
# If unset, any wallet with user_data.is_admin = TRUE may use /tip.
# TIP_ADMIN_TELEGRAM_IDS=123456789,987654321
# Per-tip caps (global; bound a single compromised admin action)
# TIP_MAX_PER_TIP_GD=10000
# TIP_MAX_PER_TIP_CELO=100
# TIP_MAX_PER_TIP_USDT=100
# TIP_MAX_PER_TIP_USDC=100
# TIP_MAX_PER_TIP_CUSD=100
# TIP_MAX_PER_TIP_XDC=10000
# Rolling UTC daily caps (bound the blast radius of a compromised admin account)
# TIP_DAILY_CAP_GD=50000
# TIP_DAILY_CAP_CELO=500
# TIP_DAILY_CAP_USDT=500
# TIP_DAILY_CAP_USDC=500
# TIP_DAILY_CAP_CUSD=500
# TIP_DAILY_CAP_XDC=50000
# Minimum seconds between tips by one admin
# TIP_RATE_LIMIT_SECONDS=15
# ── Trigger (dodge group-management bots like GroupHelp that delete "/" cmds) ──
# Trigger words (comma-separated). Telegram only treats "/" as a real command,
# so "!tip" is ignored by most group bots — a good alternative to "/tip".
# TIP_COMMAND_ALIASES=tip,gift
# Allowed leading chars for the command.
# TIP_COMMAND_PREFIXES=/!
# No-keyword form: "1" lets an admin reply "<amount> <token>" (e.g. "100 XDC")
# to a member and it is treated as a tip. Off by default.
# TIP_REPLY_TRIGGER=0
# Public "🎉 Congrats @username! You received N TOKEN" announcement in the group
# after a successful tip (usernames only — never a wallet). Default ON.
# TIP_PUBLIC_ANNOUNCE=1
# How long to keep polling for a tip's on-chain receipt across RPC fallbacks
# before reporting "submitted_unconfirmed" (seconds). A broadcast tx is a fact;
# the primary Celo node (forno) both rate-limits and lags on receipts, so keep
# this generous — a slow node must not look like a failed tip. Default 120.
# TIP_RECEIPT_TIMEOUT_SEC=120
# Delay between receipt polls (seconds). Default 2.5.
# TIP_RECEIPT_POLL_SEC=2.5
# NOTE: the bot is SILENT in group chats except for an admin tip — members'
# messages, wallet submissions and all other commands get no group reply.

# ── Community Rotating Savings (Paluwagan) — FULLY ON-CHAIN ────────────
# A separate standalone contract (GoodMarketPaluwagan.sol) that is COMPLETELY
# independent of the G$ Savings vault. It holds only its own group
# contributions; it has no owner, no pause, no emergency withdrawal, no fee
# and no reward pool. There is NO off-chain database and NO privileged key:
# every action (create/join/activate/contribute/claim) is user-signed on Celo.
#
# Deploy with:  PALUWAGAN_DEPLOY_KEY=... python contracts/deploy_paluwagan_contract.py
# then set:
# PALUWAGAN_CONTRACT=0x...            # deployed GoodMarketPaluwagan address
# PALUWAGAN_DEPLOYMENT_BLOCK=12345678 # receipt block (lower bound for the event scan).
#                                     # SET THIS IN PRODUCTION — without it the group
#                                     # list scans a bounded window instead and is slow.
# PALUWAGAN_ENABLED=1                 # kill-switch (default ON)
# PALUWAGAN_LOOKBACK_BLOCKS=120000    # fallback window when DEPLOYMENT_BLOCK is unset
#                                     # and discovery fails (~7 days of Celo blocks).
#                                     # Was 500000, which made one list load ~750
#                                     # serial eth_getLogs calls.
# PALUWAGAN_DEPLOY_SEARCH_SPAN=2000000 # bound on the eth_getCode binary search for the
#                                     # deploy block, so a missing env var can never
#                                     # walk the whole chain.
# PALUWAGAN_READ_DEADLINE=12          # soft seconds budget for one request's reads;
#                                     # on expiry the route returns partial data
#                                     # instead of hitting gunicorn's 120s kill.
# PALUWAGAN_CACHE_TTL_GROUPS=20       # seconds to cache a wallet's group list
# PALUWAGAN_CACHE_TTL_OVERVIEW=10     # seconds to cache one group's overview
# PALUWAGAN_CACHE_TTL_HISTORY=30      # seconds to cache contributions/payouts
# PALUWAGAN_CACHE_TTL_BALANCE=15      # seconds to cache G$/CELO balances
# PALUWAGAN_REMOVAL_GRACE_PERIOD=172800  # seconds a Forming member must wait before the
#                                       # creator may remove them (must match the deployed
#                                       # contract's REMOVAL_GRACE_PERIOD; default 2 days).
#                                       # Slot removal (leaveGroup/removeMember) requires the
#                                       # v2 contract — the UI probes the deployed bytecode.
# PALUWAGAN_GUIDE_URL=https://...notion.site/ebd/<page-id>
#                                     # Onboarding guide shown in a full-screen overlay on
#                                     # /paluwagan. Auto-opens once per browser (members only —
#                                     # never for a guest or an invite deep link) and is
#                                     # re-openable from "How it works". The iframe is lazy:
#                                     # its src loads on first open only. Set to an empty
#                                     # value to remove the overlay and its button entirely.
#                                     # The host must also be allowed in main.py's CSP
#                                     # frame-src (https://*.notion.site is pre-allowed).
# GETLOGS_MAX_CHUNK=4000              # eth_getLogs span ceiling (forno caps ~5000)
# GETLOGS_MIN_CHUNK=500               # smallest span the adaptive retry will use
# Visibility is also controlled by the admin "paluwagan_feature" flag.

# ── P2P G$ Trading (onchain escrow + offchain Supabase) ────────────────
# P2P_KEY is the deployer wallet for P2PEscrow.sol and becomes the contract
# owner == arbiter. It is used ONLY for the admin-review path (seller rejected
# the buyer's proof) and dispute resolution — never for normal user actions.
# P2P_KEY=0xyour_p2p_owner_private_key
# Deployed P2PEscrow address (set after running contracts/deploy_p2p_escrow.py):
# P2P_ESCROW_CONTRACT_ADDRESS=0x...
# Buyer payment window in seconds (default 1800 = 30 min):
# P2P_PAYMENT_WINDOW_SECONDS=1800

# ── Turnkey embedded-wallet + Google social login ──────────────────────
TURNKEY_ORGANIZATION_ID=your-turnkey-org-id
TURNKEY_AUTH_PROXY_CONFIG_ID=your-turnkey-auth-proxy-config-id
TURNKEY_API_PUBLIC_KEY=your-turnkey-api-public-key
TURNKEY_API_PRIVATE_KEY=your-turnkey-api-private-key
# TURNKEY_API_BASE_URL=https://api.turnkey.com   # default

# Google OAuth 2.0 (for "Login with Google" on homepage)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Community Chatroom (public room, HIDDEN by default) ────────────────
# The room is off until an admin flips "Chatroom" ON in the dashboard
# (Feature Visibility). Set up sql/community_chat.sql first.
# CHATROOM_MAX_MESSAGE_LENGTH=500
# CHATROOM_RATE_LIMIT_SECONDS=3
# Image sharing: the browser uploads images to ImgBB (needs IMGBB_API_KEY).
# CHATROOM_MAX_UPLOAD_MB=5                # max attachment size
# CHATROOM_UPLOAD_RATE_LIMIT_SECONDS=10   # per-sender upload cooldown
# CHATROOM_ATTACHMENT_HOSTS=i.ibb.co,ibb.co  # allow-list of image hosts
# CHATROOM_IMAGE_EXPIRATION_DAYS=0        # 0 = keep; else ImgBB auto-deletes

# ── Community Feed (Facebook/Instagram-style posts, HIDDEN by default) ──
# A chronological feed of user posts (caption + images/video) with reactions.
# Media bytes live in Cloudflare R2; Supabase stores metadata only. The feed is
# off until an admin flips "Community Feed" ON in the dashboard (Feature
# Visibility) — run sql/community_feed.sql first.
#
# R2 setup: create ONE bucket, connect a public custom domain (or use the
# r2.dev URL), and create an API token scoped to THAT bucket only. Set the
# bucket's CORS policy to allow PUT/GET from your app origin (see
# docs/COMMUNITY_FEED_R2_PROPOSAL.md §3.2 — a missing CORS rule is the #1
# cause of "upload failed").
#
# COMMUNITY_FEED_ENABLED=0                # hard kill switch; UNSET means "defer to
#                                         # the admin flag" (the feed is still off
#                                         # until Feature Visibility is switched on)
# R2_ACCOUNT_ID=                          # Cloudflare account id
# R2_ACCESS_KEY_ID=                       # R2 API token (bucket-scoped)
# R2_SECRET_ACCESS_KEY=                   # token secret — NEVER commit this
# R2_BUCKET=goodmarket-community
# R2_ENDPOINT=                            # default: https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=                     # e.g. https://media.goodmarketph.live
# R2_PRESIGN_TTL_SEC=600                  # signed-upload lifetime (60-3600)
# R2_MAX_IMAGE_MB=10                      # per-image cap
# R2_MAX_VIDEO_MB=100                     # per-video cap (also bounds cost)
# COMMUNITY_MAX_CAPTION=2200              # caption length (Instagram's ceiling)
# COMMUNITY_MAX_MEDIA_PER_POST=4
# COMMUNITY_POST_RATE_LIMIT_SECONDS=60    # per-wallet posting cooldown
# COMMUNITY_COMMENT_RATE_LIMIT_SECONDS=5
# COMMUNITY_UPLOAD_RATE_LIMIT_SECONDS=10  # upload presign window (see below)
# COMMUNITY_REQUIRE_USERNAME=1            # a post must carry a username, so the
#                                         # feed shows a name and never a wallet
#                                         # address. Set 0 to allow anonymous
#                                         # posts (they render as "Community
#                                         # member", never as an address).
#
# ── Community G$ rewards (see docs/COMMUNITY_REWARDS_LEDGER_PROPOSAL.md) ──
# The four rates are UNEQUAL on purpose. A comment costs the user thought and
# leaves content behind; a tap costs nothing and leaves no trace. Paying them
# the same would make the cheapest action the most profitable one, which is
# exactly what a farm does. reaction_in is the smallest for that reason.
#
#   comment_in    I commented on someone's post        (1.5)
#   comment_out   someone commented on my post         (2.5, the largest)
#   reaction_out  someone reacted to my post           (0.5)
#   reaction_in   I reacted to someone's post          (0.1, the smallest)
#
# The balance is a SUM over an append-only ledger, shown ONLY inside /community.
# v1 has NO payout path: earnings accrue and display, nothing is withdrawable.
# Seeded HIDDEN in sql/community_reward_ledger.sql; turn it on in Feature
# Visibility (community_rewards_feature) when ready. Changing a rate affects
# only FUTURE credits: the ledger is append-only, so past earnings stand.
#
# COMMUNITY_REWARDS_ENABLED=1             # hard kill switch; UNSET means "defer
#                                         # to the admin flag" (still off until
#                                         # Feature Visibility is switched on)
# COMMUNITY_REWARD_COMMENT_IN=1.5         # commenter
# COMMUNITY_REWARD_COMMENT_OUT=2.5        # post owner, on a comment received
# COMMUNITY_REWARD_REACTION_OUT=0.5       # post owner, on a reaction received
# COMMUNITY_REWARD_REACTION_IN=0.1        # the reactor (the farm vector)
# COMMUNITY_REWARD_DAILY_CAP=50           # max G$ earned per wallet per 24h
# COMMUNITY_REWARD_POST_CAP=100           # max G$ credited against one post
# COMMUNITY_REWARD_MIN_PAYOUT_GD=500      # threshold shown on the card. No
#                                         # payout path exists in v1, so this is
#                                         # a goal, not a transfer.
# COMMUNITY_REWARD_SHOW_BALANCE=1         # show signed-in members their balance
#                                         # and goal by default; guests never see
#                                         # personal figures. Set 0 to hide it.
# COMMUNITY_REWARD_START_AT=              # ISO-8601 fence: only events at/after
#                                         # this time may earn. Empty = ungated.
#                                         # Used only when a backfill is run.
# COMMUNITY_REWARD_REQUIRE_VERIFIED=1     # only a FACE-VERIFIED wallet earns.
#                                         # The check is the ON-CHAIN GoodDollar
#                                         # identity read, NOT session["verified"]
#                                         # (that is a login flag set for every
#                                         # wallet). Set 0 only to keep the
#                                         # economy alive through a chain outage.
#                                         # Fails CLOSED: an unreadable chain
#                                         # means "not eligible", never "assume
#                                         # verified".
# COMMUNITY_REWARD_ELIGIBILITY_TTL=300    # seconds a worker caches a wallet's
#                                         # verification verdict. The read is an
#                                         # RPC call on the hot path, so it is
#                                         # cached; a chain ERROR is never
#                                         # cached, so an outage is retried.
# COMMUNITY_REWARD_RATE_MAX=10            # server-side ceiling on any rate.
#                                         # The admin editor clamps to this, so a
#                                         # typo cannot set a rate above the
#                                         # daily cap. Floor is always 0, which
#                                         # is the supported "switch it off".
# COMMUNITY_REWARD_RATES_CACHE_TTL=60     # seconds a worker caches the rates.
#                                         # Per process: a write invalidates the
#                                         # worker that handled it, others catch
#                                         # up within this window.

# ── Reloadly refund retry ──────────────────────────────────────────────
# Refunds for failed Reloadly orders are parked as 'pending_refund' when the
# REFUND_KEY wallet lacks CELO gas / G$, then retried automatically. This runs
# by default; set RELOADLY_REFUND_RETRY_ENABLED=0 to disable. The admin
# dashboard "Reloadly Refunds" panel shows the wallet balance and has a
# manual "Process Refunds Now" / per-order Retry button.
# REFUND_KEY=0xyour_refund_private_key
# RELOADLY_REFUND_RETRY_ENABLED=1
# RELOADLY_REFUND_RETRY_INTERVAL_SEC=600
# RELOADLY_REFUND_RETRY_MAX_ORDERS=100
# RELOADLY_REFUND_RETRY_MAX_AGE_DAYS=14
# RELOADLY_REFUND_STALE_CLAIM_SEC=300
# RELOADLY_REFUND_RETRY_FAILED_AFTER_SEC=900

# ── "Install app" (PWA) ────────────────────────────────────────────────
# The homepage shows a persistent "Install app" banner and the wallet page
# shows a one-time one (local / email + PIN logins only). Browsers that can't
# install simply never fire `beforeinstallprompt`, so the client shows manual
# instructions instead. Set PWA_INSTALL_ENABLED=0 to hide the prompts entirely.
# PWA_INSTALL_ENABLED=1

# ── LI.FI (Jumper) bridge — Celo → Base ────────────────────────────────
# Celo → native ETH on Base, from a selectable Celo source token. Ships DARK:
# the Celo → Base sub-tab and its /api/bridge/lifi/* proxy only activate when
# LIFI_BRIDGE_ENABLED=1.
# NOTE (2026-10): a NATIVE-CELO source is rejected by LI.FI's own step-0
# simulation (TransferFromFailed), so the pane offers a stablecoin source as a
# fallback — USDC/USDT route in a SINGLE step (one signature), cUSD in two.
# Users with only CELO can run an in-app CELO → cUSD swap first.
# Set an API key: without it the anonymous bucket rate-limits aggressively
# ("retry in 2 hours") and the pane re-quotes on every keystroke.
# LIFI_BRIDGE_ENABLED=1
# LI_FI_INTEGRATOR=goodmarket
# LI_FI_API_KEY=
# Optional integrator fee (fraction, e.g. 0.003 = 0.3%). LI.FI rejects a
# non-zero fee until the integrator is registered at https://portal.li.fi/
# LI_FI_FEE=0
# BASE_CHAIN_ID=8453
# CELO_ERC20_TOKEN=0x471EcE3750Da237f93B8E339c536989b8978a438
